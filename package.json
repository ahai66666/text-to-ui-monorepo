{
  "name": "text-to-ui-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "index:build": "node text-to-ui/scripts/build-navigation-index.mjs --repo . --skill-root text-to-ui",
    "index:check": "node text-to-ui/scripts/validate-navigation-index.mjs --repo . --skill-root text-to-ui",
    "route:materials:check": "node text-to-ui/scripts/validate-navigation-index.mjs --repo . --skill-root text-to-ui",
    "route:materials:test": "node text-to-ui/scripts/test-route-materials.mjs",
    "context:resolve": "node text-to-ui/scripts/resolve-context.mjs",
    "context:materials:verify": "node text-to-ui/scripts/verify-context-materials.mjs",
    "icons:build": "node tools/build-component-icon-sprite.mjs && node tools/build-inline-icon-map.mjs && node tools/sync-core-html-fixtures.mjs && node tools/sync-generated-inline-icons.mjs && node tools/sync-legacy-primary-icons.mjs",
    "contracts:normalize": "node tools/normalize-contract-registry.mjs && node tools/enrich-contract-registry.mjs && node tools/build-parity-manifest.mjs && pnpm icons:build && node tools/build-component-runtime-module.mjs && node tools/build-file-runtime-fallback.mjs",
    "components:generate": "node tools/generate-full-component-adapters.mjs && node tools/normalize-contract-registry.mjs && node tools/enrich-contract-registry.mjs && node tools/build-parity-manifest.mjs && pnpm icons:build && node tools/build-component-runtime-module.mjs && node tools/build-file-runtime-fallback.mjs",
    "contracts:validate": "node tools/validate-components.mjs",
    "styles:validate": "node tools/validate-component-style-parity.mjs",
    "pixso:mapping:test": "node tools/expand-pixso-mapping.mjs --check && node tools/test-pixso-mapping.mjs",
    "pixso:scene:coremail": "node text-to-ui/scripts/generate-pixso-scene.mjs --page-spec apps/coremail-workbench/page-spec.json --layout-contract apps/coremail-workbench/pixso/layout-contract.json --page-data apps/coremail-workbench/pixso/page-data.json --component-map text-to-ui/assets/design-system/mapping-registry.json --out apps/coremail-workbench/pixso/pixso-scene.json --stats-out apps/coremail-workbench/pixso/scene-stats.json",
    "pixso:operation-plan:coremail": "node text-to-ui/scripts/generate-pixso-operation-plan.mjs --scene apps/coremail-workbench/pixso/pixso-scene.json --component-map text-to-ui/assets/design-system/mapping-registry.json --out apps/coremail-workbench/pixso/pixso-operation-plan.json && node text-to-ui/scripts/prepare-pixso-operation-batches.mjs --plan apps/coremail-workbench/pixso/pixso-operation-plan.json --out apps/coremail-workbench/pixso/pixso-operation-batches.json",
    "pixso:scene:test": "node text-to-ui/scripts/test-pixso-native-scene.mjs && node text-to-ui/scripts/test-pixso-two-phase-icons.mjs && node text-to-ui/scripts/test-pixso-image-runtime.mjs",
    "components:business-props:test": "node text-to-ui/scripts/test-html-business-props.mjs",
    "components:titlebar-actions:test": "node text-to-ui/scripts/test-titlebar-action-contract.mjs",
    "pixso:mcp-plan:coremail": "node text-to-ui/scripts/prepare-pixso-mcp-batches.mjs --plan apps/coremail-workbench/pixso/pixso-operation-plan.json --out apps/coremail-workbench/pixso/pixso-mcp-call-plan.json",
    "pixso:import-fast-path:test": "node text-to-ui/scripts/test-pixso-import-run.mjs && node text-to-ui/scripts/test-pixso-capture-bundle.mjs && node text-to-ui/scripts/test-pixso-import-fast-path.mjs",
    "tokens:validate": "node text-to-ui/scripts/build-pixso-token-manifest.mjs --check && node text-to-ui/scripts/build-token-runtime-map.mjs --check && node text-to-ui/scripts/build-dual-output-token-map.mjs --check",
    "mappings:validate": "node text-to-ui/scripts/validate-mapping-registry.mjs && node text-to-ui/scripts/validate-framework-pixso-parity.mjs",
    "mappings:check": "node text-to-ui/scripts/sync-mapping-registry.mjs --check && node text-to-ui/scripts/validate-mapping-registry.mjs --check-projections && node tools/expand-pixso-mapping.mjs --check",
    "mappings:sync": "node text-to-ui/scripts/sync-mapping-registry.mjs --write && node tools/expand-pixso-mapping.mjs",
    "mappings:doc": "node text-to-ui/scripts/build-mapping-registry-doc.mjs",
    "mappings:test": "node text-to-ui/scripts/test-mapping-registry.mjs",
    "mappings:obsidian:check": "node text-to-ui/scripts/sync-obsidian-mapping-edits.mjs --check",
    "mappings:obsidian:apply": "node text-to-ui/scripts/sync-obsidian-mapping-edits.mjs --write",
    "mappings:obsidian:build": "node text-to-ui/scripts/build-obsidian-mapping-workbook.mjs",
    "mappings:obsidian:test": "node text-to-ui/scripts/test-obsidian-mapping-sync.mjs",
    "frameworks:validate": "node text-to-ui/scripts/validate-framework-component-adapter-map.mjs && node text-to-ui/scripts/test-framework-component-contract.mjs && node text-to-ui/scripts/validate-framework-component-runtime.mjs && node tools/validate-runtime-parity.mjs",
    "layout:contract:test": "node text-to-ui/scripts/test-validate-pc-framework-layout.mjs",
    "layout:binding:test": "node text-to-ui/scripts/test-validate-page-layout-binding.mjs",
    "layout:markers:test": "node text-to-ui/scripts/test-validate-layout-markers.mjs",
    "layout:route:test": "node text-to-ui/scripts/test-resolve-context-pattern-gate.mjs",
    "patterns:validate": "node text-to-ui/scripts/validate-pattern-contracts.mjs",
    "patterns:resolution:test": "node text-to-ui/scripts/test-pattern-contract-resolution.mjs",
    "patterns:runtime:test": "node text-to-ui/scripts/test-pattern-runtime.mjs",
    "patterns:scene-binding:test": "node text-to-ui/scripts/test-ui-scene-pattern-binding.mjs",
    "frameworks:page-generation:test": "node text-to-ui/scripts/test-framework-page-generation.mjs",
    "page:blueprint:test": "node text-to-ui/scripts/test-page-blueprint.mjs",
    "page:design-discovery:test": "node text-to-ui/scripts/test-design-discovery.mjs",
    "components:titlebar:test": "node text-to-ui/scripts/test-titlebar-segments.mjs",
    "page:blueprint:validate": "node text-to-ui/scripts/validate-page-blueprint.mjs",
    "page:content-recipes:test": "node text-to-ui/scripts/test-page-content-recipes.mjs",
    "page:content-recipes:validate": "node text-to-ui/scripts/validate-page-content-recipes.mjs",
    "page:css-boundaries:test": "node text-to-ui/scripts/test-page-css-boundaries.mjs",
    "page:composite-boundaries:test": "node text-to-ui/scripts/test-page-composite-boundaries.mjs",
    "page:standalone": "node text-to-ui/scripts/scaffold-standalone-project.mjs",
    "page:standalone:test": "node text-to-ui/scripts/test-standalone-project.mjs",
    "components:reuse:test": "node text-to-ui/scripts/test-validate-web-component-reuse.mjs",
    "components:resolution:test": "node text-to-ui/scripts/test-primary-navigation-resolution.mjs",
    "components:readiness:test": "node text-to-ui/scripts/test-component-readiness-policy.mjs",
    "components:selection:test": "node text-to-ui/scripts/test-component-selection-rules.mjs",
    "components:acceptance:test": "node text-to-ui/scripts/test-core-component-acceptance.mjs",
    "references:approved:test": "node text-to-ui/scripts/test-approved-page-reference-policy.mjs",
    "components:strict-html:test": "node text-to-ui/scripts/test-html-strict-reuse-pipeline.mjs && node text-to-ui/scripts/test-validate-page-token-usage.mjs",
    "components:strict-html:forward": "node tools/test-strict-html-forward-fixture.mjs",
    "runtime:evidence": "node tools/validate-runtime-evidence.mjs",
    "dialogs:validate": "node tools/validate-dialog-contract.mjs",
    "runtime:evidence:strict": "node tools/validate-runtime-evidence.mjs --strict",
    "runtime:http": "node tools/validate-runtime-http.mjs",
    "skill:preview:check": "python3 text-to-ui/scripts/update_preview_cache.py --check",
    "gallery:sync-legacy": "node tools/sync-legacy-visual-baseline.mjs",
    "gallery:baseline:validate": "node tools/validate-legacy-baseline.mjs",
    "gallery:readiness:test": "node tools/test-gallery-readiness.mjs",
    "gallery:build": "pnpm gallery:sync-legacy && pnpm --filter @text-to-ui/component-gallery build && node tools/validate-gallery-dist.mjs",
    "services:start": "node text-to-ui/scripts/start-text-to-ui-services.mjs start",
    "services:status": "node text-to-ui/scripts/start-text-to-ui-services.mjs status",
    "delivery:validate": "node tools/validate-repository-delivery.mjs && pnpm skill:test",
    "test": "pnpm index:check && pnpm route:materials:test && pnpm components:readiness:test && pnpm components:selection:test && pnpm components:acceptance:test && pnpm references:approved:test && pnpm patterns:validate && pnpm patterns:resolution:test && pnpm patterns:scene-binding:test && pnpm page:blueprint:test && pnpm page:content-recipes:test && pnpm page:css-boundaries:test && pnpm page:composite-boundaries:test && pnpm frameworks:page-generation:test && pnpm mappings:check && pnpm mappings:test && pnpm mappings:obsidian:test && pnpm components:resolution:test && pnpm delivery:validate && pnpm contracts:validate && pnpm styles:validate && pnpm pixso:mapping:test && pnpm frameworks:validate && pnpm layout:contract:test && pnpm layout:binding:test && pnpm layout:markers:test && pnpm layout:route:test && pnpm components:reuse:test && pnpm components:strict-html:test && pnpm components:strict-html:forward && pnpm runtime:evidence && pnpm dialogs:validate && pnpm gallery:readiness:test && pnpm gallery:baseline:validate && pnpm tokens:validate",
    "skill:sync": "node text-to-ui/scripts/skill-delivery.mjs --write",
    "skill:check": "node text-to-ui/scripts/skill-delivery.mjs --check",
    "skill:test": "node tools/test-skill-delivery.mjs"
  }
}
