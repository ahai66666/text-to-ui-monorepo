{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.text-to-ui/pixso-component-facts.schema.json",
  "title": "Current Pixso component facts",
  "description": "A no-ID snapshot of the exact reusable component names currently resolved from a Pixso document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "document",
    "page",
    "source",
    "capturedAt",
    "scope",
    "componentSets",
    "standaloneComponents"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "text-to-ui.pixso-component-facts" },
    "document": { "type": "string", "minLength": 1 },
    "page": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "policy": { "type": "object", "additionalProperties": true },
    "componentSets": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "standaloneComponents": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "supportingComponents": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "classification", "variantAxes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["business", "helper", "supporting"] },
        "variantAxes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
